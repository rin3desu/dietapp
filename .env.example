SECRET_KEY=
# SECRET_KEY: set a random secret in production, or use an existing persistent disk.
# SESSION_KEY_FILE=/var/data/stoiq/.session-key
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=10
# PUBLIC_ORIGIN=https://your-existing-site.onrender.com
DATABASE_BACKEND=sqlite
# Render uses SQLITE_PATH=/var/data/stoiq/app.db

# Ideal-self features use the existing GEMINI_API_KEY.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
IDEAL_IMAGE_DAILY_LIMIT=3
IDEAL_TEXT_DAILY_LIMIT=10
# IDEAL_TEXT_MODEL can override GEMINI_MODEL for role-model coaching.
